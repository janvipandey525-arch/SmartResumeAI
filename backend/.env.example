# === SmartResumeAI backend configuration ===
# Copy to `.env` for local dev. In production set these in Coolify's
# Environment Variables panel. NEVER commit a real .env with secrets.

# App
APP_NAME=SmartResumeAI
ENV=development                       # development | production

# --- Database (Supabase Postgres, transaction pooler) ---
# Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# Prefix the driver as postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Supabase project ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>            # safe to expose to the browser
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # SECRET — server only

# Token verification: set the legacy shared secret, OR leave blank to verify
# against the project's JWKS endpoint (new asymmetric signing keys).
# Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=<jwt-secret>
# SUPABASE_JWT_AUD=authenticated               # rarely needs changing

# --- Storage ---
SUPABASE_STORAGE_BUCKET=resumes                # private bucket for uploaded files
STORE_UPLOADS=true

# --- AI (Gemini) — leave blank to run with AI "disabled" ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- CORS — comma-separated origins (local dev only; same-origin in prod) ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
