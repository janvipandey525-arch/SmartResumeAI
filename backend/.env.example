# === SmartResumeAI backend configuration ===
# Copy to `.env` for local dev. In production set these in Coolify's
# Environment Variables panel. NEVER commit a real .env with secrets.

# App
APP_NAME=SmartResumeAI
ENV=development                       # development | production

# Database
# Local dev (default): SQLite file, zero setup.
DATABASE_URL=sqlite:///./smartresume.db
# Production (Coolify Postgres) example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Auth (JWT) — generate a strong secret for prod: `openssl rand -hex 32`
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI (Gemini) — leave blank to run with AI "disabled".
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-flash-latest = alias that always tracks the current stable Flash model
# (won't 404 when Google deprecates a dated version like 2.5-flash).
GEMINI_MODEL=gemini-flash-latest

# CORS — comma-separated origins allowed to call the API (local dev only).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
